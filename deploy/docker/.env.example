# Existing dedicated directory on the Ubuntu host. Do not mount your whole home.
T3_WORKSPACE_DIR=/srv/t3-workspace

# Set to the Docker host's hostname; installation instructions populate this.
# T3_HOSTNAME=homelab

# Optional version overrides. Omit these to use Dockerfile defaults: latest releases,
# Node 26, Docker 29, and the .NET 10.0 SDK channel.
# NODE_VERSION=26
# DOCKER_VERSION=29
# DOTNET_CHANNEL=10.0
# Exact pins are also supported via T3_VERSION, NPM_VERSION, N_VERSION,
# UV_VERSION, GH_VERSION, DOTNET_VERSION, CODEX_VERSION, CLAUDE_VERSION,
# and OPENCODE_VERSION.

# providers includes Codex, Claude, and OpenCode; runtime includes T3 and dev tools.
T3_IMAGE_TARGET=providers
T3_CPUS=4
T3_MEMORY=8g
T3_DOCKER_CPUS=4
T3_DOCKER_MEMORY=8g
T3_LOG_LEVEL=Info
