# Existing dedicated directory on the Ubuntu host. Do not mount your whole home.
T3_WORKSPACE_DIR=/srv/t3-workspace

# Set to the Docker host's hostname; installation instructions populate this.
# T3_HOSTNAME=homelab

# Pins seed new home volumes. Agents can update user tools in existing volumes.
NODE_VERSION=26.10.0
NPM_VERSION=12.2.0
T3_VERSION=0.0.45
N_VERSION=10.2.0
UV_VERSION=0.12.22
GH_VERSION=2.102.0
CODEX_VERSION=0.160.0
CLAUDE_VERSION=2.1.287
OPENCODE_VERSION=1.18.34

# providers includes Codex, Claude, and OpenCode; runtime includes T3 and dev tools.
T3_IMAGE_TARGET=providers
T3_CPUS=4
T3_MEMORY=8g
T3_LOG_LEVEL=Info
